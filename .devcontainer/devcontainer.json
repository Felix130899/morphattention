{
  "name": "ViT Morphology Project",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "vit-project",
  "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-vscode.makefile-tools"
      ]
    }
  },
  "postCreateCommand": "pip install -r requirements.txt",
  "remoteUser": "vituser"
}
