{
  "name": "ViT Morphology Project",
  "dockerComposeFile": ["../docker-compose.yml", "../docker-compose.override.yml"],
  "service": "vit-project",
  "workspaceFolder": "/workspace",
  "initializeCommand": "test -f docker-compose.override.yml || cp docker-compose.override.example.yml docker-compose.override.yml",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-vscode.makefile-tools"
      ]
    }
  },
  "postCreateCommand": "pip install -r requirements.txt -c constraints.txt",
  "remoteUser": "vituser"
}
